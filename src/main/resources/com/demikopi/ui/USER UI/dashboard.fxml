<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="main-bg" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <!-- SIDEBAR (Kiri) -->
    <left>
        <VBox prefWidth="220.0" spacing="20" style="-fx-border-color: #D3D3D3; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20" left="15" right="15" top="20" />
            </padding>

            <!-- Bagian Logo Atas -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Region prefHeight="35" prefWidth="35" style="-fx-background-color: fx-primary; -fx-background-radius: 50;" />
                <VBox>
                    <Label style="-fx-font-weight: bold; -fx-text-fill: fx-primary; -fx-font-size: 14;" text="DemiKopi" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #888;" text="Coffee Assistant" />
                </VBox>
            </HBox>

            <!-- Spacer: Mendorong tombol New Chat ke bawah -->
            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" styleClass="button-outline" text="+ New Chat" />
        </VBox>
    </left>

    <!-- AREA UTAMA (Tengah) -->
    <center>
        <VBox>
            <!-- Header Atas -->
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-border-color: #D3D3D3; -fx-border-width: 0 0 1 0;">
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
                <Label style="-fx-font-weight: bold;" text="DemiKopi Coffee Assistant" />
                <Label style="-fx-text-fill: #2ecc71; -fx-font-size: 10;" text="● Online" />
                <Region HBox.hgrow="ALWAYS" />
                <Label style="-fx-font-size: 18; -fx-text-fill: #888;" text="👤" />
            </HBox>

            <!-- Area Chat (Tengah - Akan melebar/expand) -->
            <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="20" style="-fx-padding: 20;">

                    <!-- 1. TAMBAHKAN REGION INI di paling atas -->
                    <!-- Ini akan mendorong semua konten di bawahnya ke posisi paling bawah -->
                    <Region VBox.vgrow="ALWAYS" />

                    <!-- 2. Pesan Bot -->
                    <HBox alignment="BOTTOM_LEFT" spacing="10">
                        <Region minWidth="30" prefHeight="58.0" prefWidth="40.0" style="-fx-background-color: fx-primary; -fx-background-radius: 50;" />
                        <Label maxWidth="350" styleClass="bubble-bot" text="Halo Saya DemiKopi Bot. Mau cari yang manis atau yang strong? Atau lihat menu kami?" textOverrun="CLIP" wrapText="true" />
                    </HBox>

                </VBox>
            </ScrollPane>

            <!-- Input Area (PASTI DI BAWAH karena ScrollPane di atas vgrow="ALWAYS") -->
            <HBox alignment="CENTER" spacing="10">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="10" />
                </padding>
                <TextField promptText="Tempat Prompt" styleClass="text-input" HBox.hgrow="ALWAYS" />
                <Button prefHeight="40" prefWidth="40" styleClass="button-primary" text="➤" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
