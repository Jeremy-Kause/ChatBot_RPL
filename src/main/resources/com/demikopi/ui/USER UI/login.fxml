<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="600.0" prefWidth="900.0" styleClass="main-bg" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <VBox alignment="CENTER" maxWidth="400" spacing="25" styleClass="login-card" StackPane.alignment="CENTER">

        <!-- Logo Bulat Cokelat -->
        <Region prefHeight="70" prefWidth="70" maxWidth="70" styleClass="logo-circle" />

        <VBox alignment="CENTER" spacing="5">
            <Label styleClass="login-title" text="DemiKopi Coffee Assistant" />
            <Label styleClass="login-subtitle" text="Silakan masuk ke akun Anda" />
        </VBox>

        <!-- Form Input -->
        <VBox spacing="15">
            <TextField promptText="Username" styleClass="text-input" />
            <PasswordField promptText="Password" styleClass="text-input" />
        </VBox>

        <!-- Action Buttons -->
        <VBox spacing="10">
            <Button maxWidth="Infinity" styleClass="button-primary" text="Login">
                <padding>
                    <Insets bottom="12" top="12" />
                </padding>
            </Button>

            <Button maxWidth="Infinity" styleClass="button-outline" text="Register">
                <padding>
                    <Insets bottom="12" top="12" />
                </padding>
            </Button>
        </VBox>

    </VBox>
</StackPane>