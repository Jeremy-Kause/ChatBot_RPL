<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" styleClass="main-bg" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- HEADER ADMIN -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: -fx-white; -fx-border-color: #D3D3D3; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="15" left="25" right="25" top="15" />
            </padding>

            <!-- Logo Bulat -->
            <Region prefHeight="40" prefWidth="40" style="-fx-background-color: -fx-primary; -fx-background-radius: 50;" />

            <VBox HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="DemiKopi Admin" />
                <Label style="-fx-text-fill: #888; -fx-font-size: 11;" text="Menu Management" />
            </VBox>

            <!-- Tombol Logout -->
            <Button style="-fx-background-color: transparent; -fx-border-color: #ff7675; -fx-border-radius: 5; -fx-text-fill: #ff7675; -fx-cursor: hand;" text="Logout →" />
        </HBox>
    </top>

    <!-- CONTENT (Tabel Menu) -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: -fx-primary;" text="Manajemen Menu Kopi" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="button-primary" text="+ Tambah Menu" style="-fx-padding: 8 20;" />
            </HBox>

            <!-- Tabel sesuai desain Figma -->
            <TableView fx:id="menuTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-radius: 10;">
                <columns>
                    <TableColumn prefWidth="100.0" text="Gambar" />
                    <TableColumn prefWidth="180.0" text="Nama Menu" />
                    <TableColumn prefWidth="300.0" text="Deskripsi" />
                    <TableColumn prefWidth="120.0" text="Harga" />
                    <TableColumn prefWidth="120.0" text="Aksi" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

</BorderPane>