<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="800.0" styleClass="main-bg" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- HEADER (Logo & Info Bot Pindah Ke Sini) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header-container">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <!-- Logo DemiKopi -->
            <Region prefHeight="40" prefWidth="40" styleClass="logo-circle" />

            <VBox HBox.hgrow="ALWAYS">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="DemiKopi Coffee Assistant" />
                <Label style="-fx-text-fill: #2ecc71; -fx-font-size: 11;" text="● Online | Siap melayani pesanan Anda" />
            </VBox>

            <!-- Tombol Opsional: Bersihkan Chat (Daripada New Chat) -->
            <Button style="-fx-background-color: transparent; -fx-text-fill: #888; -fx-cursor: hand;" text="Clear Chat" />
        </HBox>
    </top>

    <!-- AREA CHAT (Full Width) -->
    <center>
        <VBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="20" style="-fx-padding: 25;">
                    <Region VBox.vgrow="ALWAYS" /> <!-- Mendorong chat ke bawah -->

                    <!-- Pesan Bot -->
                    <HBox alignment="BOTTOM_LEFT" spacing="10">
                        <Region minHeight="30" minWidth="30" styleClass="logo-circle" prefWidth="30" prefHeight="30" />
                        <Label maxWidth="450" styleClass="bubble-bot" text="Halo! Saya bot DemiKopi. Mau cari kopi yang manis, strong, atau mau lihat menu hari ini?" wrapText="true" />
                    </HBox>
                </VBox>
            </ScrollPane>

            <!-- INPUT AREA -->
            <HBox alignment="CENTER" spacing="12">
                <padding>
                    <Insets bottom="25" left="30" right="30" top="10" />
                </padding>
                <TextField promptText="Tanya sesuatu tentang kopi kami..." styleClass="text-input" HBox.hgrow="ALWAYS" />
                <Button prefHeight="45" prefWidth="45" styleClass="button-primary" text="➤" />
            </HBox>
        </VBox>
    </center>
</BorderPane>