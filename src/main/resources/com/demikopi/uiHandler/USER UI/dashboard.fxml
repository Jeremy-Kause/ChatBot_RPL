<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" styleClass="main-bg" stylesheets="@../user.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header-container">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15"/>
            </padding>

            <Region prefHeight="40" prefWidth="40" styleClass="logo-circle"/>

            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="assistant-title" text="DemiKopi Coffee Assistant"/>
                <Label styleClass="assistant-status" text="Online | Siap melayani pesanan Anda"/>
            </VBox>

            <Button styleClass="clear-button" text="Clear Chat"/>
        </HBox>
    </top>

    <center>
        <VBox>
            <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="chat-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="20" styleClass="chat-stream">
                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox alignment="BOTTOM_LEFT" spacing="10">
                        <Region minHeight="30" minWidth="30" prefHeight="30" prefWidth="30" styleClass="logo-circle"/>
                        <Label maxWidth="450" styleClass="bubble-bot"
                               text="Halo! Saya bot DemiKopi. Mau cari kopi yang manis, strong, atau mau lihat menu hari ini?"
                               wrapText="true"/>
                    </HBox>
                </VBox>
            </ScrollPane>

            <HBox alignment="CENTER" spacing="12" styleClass="input-bar">
                <padding>
                    <Insets bottom="25" left="30" right="30" top="10"/>
                </padding>
                <TextField promptText="Tanya sesuatu tentang kopi kami..." styleClass="text-input" HBox.hgrow="ALWAYS"/>
                <Button prefHeight="45" prefWidth="86" styleClass="send-button" text="Kirim"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
