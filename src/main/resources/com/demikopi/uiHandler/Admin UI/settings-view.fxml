<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="1000.0" styleClass="main-bg" stylesheets="@../admin.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.demikopi.uiHandler.AdminSettingsController">
    <left>
        <VBox prefWidth="180.0" styleClass="sidebar">
            <padding>
                <Insets bottom="18.0" left="12.0" right="12.0" top="18.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sidebar-logo-box">
                <StackPane maxHeight="36.0" maxWidth="36.0" prefHeight="36.0" prefWidth="36.0" styleClass="logo-circle">
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../asset/coffee-cup.png" />
                        </image>
                        <effect>
                            <ColorAdjust brightness="1.0" saturation="-1.0" />
                        </effect>
                    </ImageView>
                </StackPane>
                <VBox spacing="2.0">
                    <Label styleClass="sidebar-logo" text="DemiKopi" />
                    <Label styleClass="sidebar-logo-sub" text="Admin Panel" />
                </VBox>
            </HBox>

            <Region prefHeight="16.0" />

            <Label styleClass="nav-section-label" text="MENU UTAMA" />
            <VBox spacing="4.0">
                <Button maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-item" text="Dashboard" />
                <Button maxWidth="Infinity" onAction="#showMenu" styleClass="nav-item" text="Manajemen Menu" />
                <Button maxWidth="Infinity" onAction="#showFasilitas" styleClass="nav-item" text="Manajemen Fasilitas" />
                <Button maxWidth="Infinity" onAction="#showLokasi" styleClass="nav-item" text="Lokasi Kedai" />
            </VBox>

            <Region prefHeight="12.0" />

            <Label styleClass="nav-section-label" text="SISTEM" />
            <VBox spacing="4.0">
                <Button maxWidth="Infinity" onAction="#showSettings" styleClass="nav-item nav-active" text="Pengaturan" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#showChatbot" styleClass="nav-item" text="Kembali ke Chatbot" />
            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-item nav-logout" text="Keluar" />
        </VBox>
    </left>

    <center>
        <VBox spacing="12.0" styleClass="content-area">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <VBox spacing="3.0">
                    <Label styleClass="page-title" text="Pengaturan Akun" />
                    <Label styleClass="page-subtitle" text="Lihat admin yang sedang login dan ubah password" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleMuatUlangAkun" styleClass="soft-button" text="Muat Ulang" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="12.0" styleClass="page-shell">
                        <HBox alignment="TOP_LEFT" spacing="16.0">
                            <VBox minWidth="0.0" spacing="16.0" styleClass="settings-main-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="4.0">
                                    <Label styleClass="section-title" text="Akun Admin" />
                                    <Label styleClass="card-subtitle" text="Data ini berasal dari admin yang berhasil login" />
                                </VBox>

                                <GridPane hgap="18.0" vgap="14.0" styleClass="settings-form-grid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="132.0" prefWidth="140.0" />
                                        <ColumnConstraints hgrow="ALWAYS" />
                                    </columnConstraints>

                                    <Label styleClass="settings-field-label" text="Nama Admin" GridPane.rowIndex="0" />
                                    <Label fx:id="namaAdminLabel" maxWidth="Infinity" styleClass="account-value-label" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                    <Label styleClass="settings-field-label" text="Username" GridPane.rowIndex="1" />
                                    <Label fx:id="usernameAdminLabel" maxWidth="Infinity" styleClass="account-value-label" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                </GridPane>

                                <Separator styleClass="settings-divider" />

                                <VBox spacing="10.0">
                                    <VBox spacing="4.0">
                                        <Label styleClass="section-title" text="Ganti Password" />
                                        <Label styleClass="card-subtitle" text="Masukkan password lama, lalu buat password baru" />
                                    </VBox>

                                    <GridPane hgap="18.0" vgap="14.0" styleClass="settings-form-grid">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="132.0" prefWidth="140.0" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>

                                        <Label styleClass="settings-field-label" text="Password Lama" GridPane.rowIndex="0" />
                                        <PasswordField fx:id="passwordLamaInput" maxWidth="Infinity" promptText="Masukkan password lama" styleClass="settings-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label styleClass="settings-field-label" text="Password Baru" GridPane.rowIndex="1" />
                                        <PasswordField fx:id="passwordBaruInput" maxWidth="Infinity" promptText="Minimal 4 karakter" styleClass="settings-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label styleClass="settings-field-label" text="Konfirmasi" GridPane.rowIndex="2" />
                                        <PasswordField fx:id="konfirmasiPasswordInput" maxWidth="Infinity" promptText="Ulangi password baru" styleClass="settings-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </GridPane>
                                </VBox>

                                <Separator styleClass="settings-divider" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label fx:id="statusAkunLabel" styleClass="settings-save-status" text="Memuat akun..." />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button onAction="#handleBersihkanPassword" styleClass="soft-button" text="Bersihkan" />
                                    <Button onAction="#handleGantiPassword" styleClass="settings-primary-button" text="Simpan Password" />
                                </HBox>
                            </VBox>

                            <VBox minWidth="250.0" prefWidth="260.0" spacing="10.0" styleClass="settings-side-panel">
                                <VBox spacing="4.0">
                                    <Label styleClass="section-title" text="Catatan" />
                                    <Label styleClass="card-subtitle" text="Panduan sederhana untuk admin" />
                                </VBox>

                                <VBox spacing="12.0" styleClass="settings-summary-panel">
                                    <VBox spacing="4.0">
                                        <Label styleClass="settings-status-title" text="Sesi Aktif" />
                                        <Label styleClass="settings-status-value" text="Admin Login" wrapText="true" />
                                        <Label styleClass="settings-status-subtitle" text="Halaman ini membaca username dari sesi login admin" wrapText="true" />
                                    </VBox>

                                    <Separator styleClass="settings-divider" />

                                    <VBox spacing="8.0">
                                        <Label styleClass="settings-check-label" text="Gunakan password yang mudah diingat oleh admin terkait." wrapText="true" />
                                        <Label styleClass="settings-check-label" text="Setelah password diganti, login berikutnya harus memakai password baru." wrapText="true" />
                                    </VBox>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
