<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="650.0" prefWidth="1000.0" styleClass="main-bg" stylesheets="@../admin.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.demikopi.uiHandler.MenuManagementController">
    <left>
        <VBox prefWidth="180.0" styleClass="sidebar">
            <padding>
                <Insets bottom="18.0" left="12.0" right="12.0" top="18.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sidebar-logo-box">
                <StackPane maxHeight="36.0" maxWidth="36.0" prefHeight="36.0" prefWidth="36.0" styleClass="logo-circle">
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                        <image>
                            <Image url="@../asset/coffee-cup.png" />
                        </image>
                        <effect>
                            <ColorAdjust brightness="1.0" saturation="-1.0" />
                        </effect>
                    </ImageView>
                </StackPane>
                <VBox spacing="2.0">
                    <Label styleClass="sidebar-logo" text="DemiKopi" />
                    <Label styleClass="sidebar-logo-sub" text="Admin Panel" />
                </VBox>
            </HBox>

            <Region prefHeight="16.0" />

            <Label styleClass="nav-section-label" text="MENU UTAMA" />
            <VBox spacing="4.0">
                <Button maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-item" text="Dashboard" />
                <Button maxWidth="Infinity" onAction="#showMenu" styleClass="nav-item nav-active" text="Manajemen Menu" />
                <Button maxWidth="Infinity" onAction="#showFasilitas" styleClass="nav-item" text="Manajemen Fasilitas" />
                <Button maxWidth="Infinity" onAction="#showLokasi" styleClass="nav-item" text="Lokasi Kedai" />
            </VBox>

            <Region prefHeight="12.0" />

            <Label styleClass="nav-section-label" text="SISTEM" />
            <VBox spacing="4.0">
                <Button maxWidth="Infinity" onAction="#showSettings" styleClass="nav-item" text="Pengaturan" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#showChatbot" styleClass="nav-item" text="Kembali ke Chatbot" />
            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-item nav-logout" text="Keluar" />
        </VBox>
    </left>

    <center>
        <VBox spacing="12.0" styleClass="content-area">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <VBox spacing="3.0">
                    <Label styleClass="page-title" text="Manajemen Menu" />
                    <Label styleClass="page-subtitle" text="Tambah, ubah, hapus, dan filter menu DemiKopi" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRefreshMenu" styleClass="soft-button" text="Refresh" />
            </HBox>

            <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                <VBox minWidth="0.0" spacing="10.0" styleClass="table-section" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="4.0">
                            <Label styleClass="section-title" text="Daftar Menu" />
                            <Label fx:id="statusMenuLabel" styleClass="card-subtitle" text="Menampilkan 0 dari 0 menu" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <TextField fx:id="searchInput" onKeyReleased="#handleCariMenu" promptText="Cari nama, kategori, rasa, atau sajian..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="statusFilterInput" onAction="#handleFilterMenu" prefWidth="120.0" styleClass="settings-field" />
                    </HBox>

                    <TableView fx:id="menuTable" styleClass="menu-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="gambarColumn" prefWidth="66.0" text="Gambar" />
                            <TableColumn fx:id="namaMenuColumn" prefWidth="125.0" text="Nama Menu" />
                            <TableColumn fx:id="kategoriColumn" prefWidth="75.0" text="Kategori" />
                            <TableColumn fx:id="hargaColumn" prefWidth="80.0" text="Harga" />
                            <TableColumn fx:id="statusColumn" prefWidth="70.0" text="Status" />
                            <TableColumn fx:id="bestsellerColumn" prefWidth="75.0" text="Bestseller" />
                        </columns>
                    </TableView>
                </VBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="260.0" prefWidth="270.0" styleClass="content-scroll">
                    <content>
                        <VBox spacing="8.0" styleClass="table-section">
                            <VBox spacing="4.0">
                                <Label fx:id="formTitleLabel" styleClass="section-title" text="Tambah Menu" />
                                <Label styleClass="card-subtitle" text="Pilih baris tabel untuk mengedit menu" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="form-label" text="Nama Menu" />
                                <TextField fx:id="namaMenuInput" promptText="Contoh: Kopi Susu Gula Aren" styleClass="settings-field" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="form-label" text="Kategori" />
                                <ComboBox fx:id="kategoriInput" maxWidth="Infinity" styleClass="settings-field" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="form-label" text="Profil Rasa" />
                                <TextField fx:id="profilRasaInput" promptText="manis, creamy, caramel" styleClass="settings-field" />
                            </VBox>

                            <HBox spacing="8.0">
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="Suhu Sajian" />
                                    <TextField fx:id="suhuSajianInput" promptText="panas/dingin" styleClass="settings-field" />
                                </VBox>
                                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="form-label" text="Harga" />
                                    <TextField fx:id="hargaInput" promptText="25000" styleClass="settings-field" />
                                </VBox>
                            </HBox>

                            <VBox spacing="5.0">
                                <Label styleClass="form-label" text="Deskripsi" />
                                <TextArea fx:id="deskripsiInput" prefRowCount="2" promptText="Deskripsi singkat menu" styleClass="settings-field" wrapText="true" />
                            </VBox>

                            <VBox spacing="5.0">
                                <Label styleClass="form-label" text="Path Gambar" />
                                <StackPane fx:id="imageDropZone" prefHeight="118.0" styleClass="image-drop-zone">
                                    <VBox alignment="CENTER" spacing="6.0">
                                        <ImageView fx:id="imagePreview" fitHeight="64.0" fitWidth="120.0" preserveRatio="true" styleClass="image-preview" />
                                        <Label fx:id="imageDropLabel" alignment="CENTER" styleClass="image-drop-label" text="Drop gambar menu di sini atau klik untuk pilih" textAlignment="CENTER" wrapText="true" />
                                    </VBox>
                                </StackPane>
                                <TextField fx:id="imagePathInput" editable="false" promptText="asset/menu/caramel-macchiato.jpg" styleClass="settings-field" />
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <CheckBox fx:id="bestsellerCheck" styleClass="settings-check" text="Bestseller" />
                                <CheckBox fx:id="tersediaCheck" styleClass="settings-check" text="Tersedia" />
                            </HBox>

                            <HBox alignment="CENTER_RIGHT" spacing="6.0">
                                <Button onAction="#handleBersihkanForm" styleClass="soft-button" text="Bersihkan" />
                                <Button onAction="#handleHapusMenu" styleClass="danger-button" text="Hapus" />
                                <Button onAction="#handleSimpanMenu" styleClass="button-primary" text="Simpan" />
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </HBox>
        </VBox>
    </center>
</BorderPane>
