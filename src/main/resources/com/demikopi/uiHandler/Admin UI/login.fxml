<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane fx:controller="com.demikopi.uiHandler.AdminLoginController" prefHeight="600.0" prefWidth="900.0" styleClass="main-bg" stylesheets="@../admin.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">

    <VBox alignment="CENTER" maxWidth="400" spacing="25" styleClass="login-card" StackPane.alignment="CENTER">

        <!-- Logo Bulat Cokelat -->
        <StackPane maxHeight="70.0" maxWidth="70.0" prefHeight="70.0" prefWidth="70.0" styleClass="logo-circle">
            <ImageView fitHeight="44.0" fitWidth="44.0" preserveRatio="true">
                <image>
                    <Image url="@../asset/coffee-cup.png" />
                </image>
                <effect>
                    <ColorAdjust brightness="1.0" saturation="-1.0" />
                </effect>
            </ImageView>
        </StackPane>

        <VBox alignment="CENTER" spacing="5">
            <Label styleClass="login-title" text="Chatbot DemiKopi Admin" textAlignment="CENTER" />
            <Label styleClass="login-subtitle" text="Silakan masuk ke akun Anda" />
        </VBox>

        <!-- Form Input -->
        <VBox spacing="15">
            <TextField fx:id="usernameInput" promptText="Username" styleClass="text-input" />
            <PasswordField fx:id="passInput" promptText="Password" styleClass="text-input" />
        </VBox>

        <!-- Action Buttons -->
        <VBox spacing="10">
            <Button maxWidth="Infinity" styleClass="button-primary" text="Login" onAction="#handleLogin">
                <padding>
                    <Insets bottom="12" top="12" />
                </padding>
            </Button>
        </VBox>

    </VBox>
</StackPane>
