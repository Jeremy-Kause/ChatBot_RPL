<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="720.0" prefWidth="1200.0" styleClass="main-bg" stylesheets="@../admin.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.demikopi.uiHandler.AdminDashboardController">

    <left>
        <VBox prefWidth="220.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="16.0" right="16.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="sidebar-logo-box">
                <StackPane maxHeight="42.0" maxWidth="42.0" prefHeight="42.0" prefWidth="42.0" styleClass="logo-circle">
                    <ImageView fitHeight="28.0" fitWidth="28.0" preserveRatio="true">
                        <image>
                            <Image url="@../asset/coffee-cup.png" />
                        </image>
                        <effect>
                            <ColorAdjust brightness="1.0" saturation="-1.0" />
                        </effect>
                    </ImageView>
                </StackPane>
                <VBox spacing="2.0">
                    <Label styleClass="sidebar-logo" text="DemiKopi" />
                    <Label styleClass="sidebar-logo-sub" text="Admin Panel" />
                </VBox>
            </HBox>

            <Region prefHeight="24.0" />

            <Label styleClass="nav-section-label" text="MENU UTAMA" />
            <VBox spacing="4.0">
                <Button maxWidth="Infinity" onAction="#showDashboard" styleClass="nav-item nav-active" text="Dashboard" />
                <Button maxWidth="Infinity" onAction="#showMenu" styleClass="nav-item" text="Manajemen Menu" />
                <Button maxWidth="Infinity" onAction="#showFasilitas" styleClass="nav-item" text="Manajemen Fasilitas" />
            </VBox>

            <Region prefHeight="16.0" />

            <Label styleClass="nav-section-label" text="SISTEM" />
            <VBox spacing="4.0">
                <Button maxWidth="Infinity" onAction="#showSettings" styleClass="nav-item" text="Pengaturan" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-item nav-logout" text="Keluar" />
        </VBox>
    </left>

    <center>
        <VBox spacing="18.0" styleClass="content-area">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="3.0">
                    <Label styleClass="page-title" text="Dashboard" />
                    <Label styleClass="page-subtitle" text="Ringkasan data admin chatbot DemiKopi" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleRefreshDashboard" styleClass="soft-button" text="Refresh" />
                <Label fx:id="lblTanggal" styleClass="date-label" text="-" />
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="18.0" styleClass="page-shell">
                        <GridPane hgap="14.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            </columnConstraints>

                            <VBox spacing="6.0" styleClass="stat-card" GridPane.columnIndex="0">
                                <Label styleClass="stat-label" text="Total Menu" />
                                <Label fx:id="totalMenuLabel" styleClass="stat-value" text="--" />
                                <Label styleClass="stat-change-neutral" text="Semua data menu" />
                            </VBox>

                            <VBox spacing="6.0" styleClass="stat-card" GridPane.columnIndex="1">
                                <Label styleClass="stat-label" text="Menu Tersedia" />
                                <Label fx:id="menuTersediaLabel" styleClass="stat-value" text="--" />
                                <Label styleClass="stat-change-up" text="Ditampilkan ke user" />
                            </VBox>

                            <VBox spacing="6.0" styleClass="stat-card" GridPane.columnIndex="2">
                                <Label styleClass="stat-label" text="Bestseller" />
                                <Label fx:id="bestsellerLabel" styleClass="stat-value" text="--" />
                                <Label styleClass="stat-change-neutral" text="Prioritas rekomendasi" />
                            </VBox>

                            <VBox spacing="6.0" styleClass="stat-card" GridPane.columnIndex="3">
                                <Label styleClass="stat-label" text="Fasilitas" />
                                <Label fx:id="fasilitasLabel" styleClass="stat-value" text="--" />
                                <Label styleClass="stat-change-neutral" text="Data fasilitas kedai" />
                            </VBox>
                        </GridPane>

                        <HBox spacing="18.0">
                            <VBox spacing="12.0" styleClass="table-section" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT">
                                    <VBox spacing="4.0">
                                        <Label styleClass="section-title" text="Ringkasan Operasional" />
                                        <Label styleClass="card-subtitle" text="Status data yang dipakai chatbot" />
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="databaseStatusLabel" styleClass="chip chip-highlight" text="-" />
                                </HBox>

                                <HBox styleClass="list-header">
                                    <Label styleClass="list-header-label flex-label" text="Bagian" />
                                    <Label styleClass="list-header-label list-wide" text="Keterangan" />
                                    <Label styleClass="list-header-label" text="Status" />
                                </HBox>

                                <VBox fx:id="ringkasanOperasionalList" spacing="0.0" />
                            </VBox>

                            <VBox prefWidth="290.0" spacing="12.0" styleClass="side-panel">
                                <Label styleClass="section-title" text="Sorotan" />

                                <VBox spacing="10.0" styleClass="mini-card">
                                    <Label styleClass="mini-card-title" text="Top Menu" />
                                    <Label fx:id="topMenuLabel" styleClass="mini-card-value" text="--" wrapText="true" />
                                    <Label styleClass="card-subtitle" text="Bestseller tersedia pertama" />
                                </VBox>

                                <VBox spacing="10.0" styleClass="mini-card">
                                    <Label styleClass="mini-card-title" text="Top Kategori" />
                                    <Label fx:id="topKategoriLabel" styleClass="mini-card-value" text="--" wrapText="true" />
                                    <Label styleClass="card-subtitle" text="Kategori dengan item terbanyak" />
                                </VBox>

                                <VBox spacing="10.0" styleClass="mini-card">
                                    <Label styleClass="mini-card-title" text="Info Kedai" />
                                    <Label fx:id="infoKedaiStatusLabel" styleClass="mini-card-value" text="--" />
                                    <Label styleClass="card-subtitle" text="Jam buka, lokasi, dan kontak" />
                                </VBox>

                                <VBox spacing="10.0" styleClass="mini-card accent-card">
                                    <Label styleClass="mini-card-title light-text" text="Agenda Admin" />
                                    <Label fx:id="agendaLabel" styleClass="mini-card-value light-text" text="--" wrapText="true" />
                                    <Label styleClass="card-subtitle light-subtext" text="Tindak lanjut data hari ini" wrapText="true" />
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
