<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="com.demikopi.uiHandler.AdminDashboardController" prefHeight="600.0" prefWidth="900.0" styleClass="main-bg" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">

    <!-- HEADER ADMIN -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="header-container">
            <padding>
                <Insets bottom="15" left="25" right="25" top="15" />
            </padding>

            <Region prefHeight="40" prefWidth="40" styleClass="logo-circle" />

            <VBox HBox.hgrow="ALWAYS">
                <Label styleClass="admin-title" text="DemiKopi Admin" />
                <Label styleClass="admin-subtitle" text="Menu Management" />
            </VBox>

            <Button styleClass="btn-logout" text="Logout →" />
        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label styleClass="content-title" text="Manajemen Menu Kopi" />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="button-primary" text="+ Tambah Menu" />
            </HBox>

            <TableView fx:id="menuTable" styleClass="menu-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="namaMenuColumn" prefWidth="180.0" text="Nama Menu" />
                    <TableColumn fx:id="kategoriColumn" prefWidth="120.0" text="Kategori" />
                    <TableColumn fx:id="hargaColumn" prefWidth="110.0" text="Harga" />
                    <TableColumn fx:id="deskripsiMenuColumn" prefWidth="300.0" text="Deskripsi" />
                    <TableColumn fx:id="aksiColumn" prefWidth="100.0" text="Aksi" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
